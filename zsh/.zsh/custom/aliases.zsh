# package management
alias apt-up="sudo apt update && sudo apt upgrade && sudo apt autoremove"

# file safety
alias mv="mv -nv"
alias cp="cp -rnv"

# navigation
alias ~="cd ~"
alias ..="cd .."
alias ...="cd ../.."
alias mkdir="mkdir -pv"
alias ll="ls -lAh --color=auto --group-directories-first --time-style='+%Y_%m_%d %H:%M'"
